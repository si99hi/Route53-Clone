DATABASE_URL=sqlite:///./route53_clone.db
JWT_SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_ORIGIN=http://localhost:3000
DEBUG=true

# Email Configuration for Production (Render/Cloud)
# Use Resend API (recommended) or Brevo API - these work via HTTPS (port 443)
# Get free API key at https://resend.com/signup or https://www.brevo.com/
RESEND_API_KEY=your-resend-api-key-here
BREVO_API_KEY=your-brevo-api-key-here

# SMTP Configuration (only for local development - blocked on Render)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
